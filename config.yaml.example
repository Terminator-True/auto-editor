# DaVinci Resolve automation orchestrator — configuration.
# Copy to config.yaml and adjust to your environment.

resolve:
  # Absolute path to the directory containing the DaVinciResolveScript module
  # (e.g. /opt/resolve/Developer/Scripting/Modules). Leave null to rely on the
  # standard import path and platform-default directories.
  script_path: null
  # Log the detected Resolve version (Studio vs free) on connect.
  detect_version: true

log:
  # Path to the JSON-lines audit log file.
  path: logs/run.jsonl
  # Default log level for records written to the audit log.
  level: info

ollama:
  # Local Ollama API endpoint (default http://localhost:11434).
  endpoint: http://localhost:11434
  # Model to use for the probe / LLM stage.
  model: qwen2.5:14b
  # Sampling temperature passed with each request.
  temperature: 0.2
  # Request timeout in seconds before failing with a timeout error.
  timeout: 120.0
  # Path to the versioned system-role prompt template. Defaults to the
  # package's prompts/system.md; override to point at a custom template.
  prompt_template: prompts/system.md

pipeline:
  # Operation mode for the --e2e flow: 'marker' (non-destructive default) adds
  # timeline markers at the suggested points; 'auto' validates decision ranges
  # and logs intended cuts without mutating the timeline (stubbed per §3.3).
  mode: marker

transcription:
  # Path to the .srt transcription source used by --e2e when --srt is omitted.
  # Leave null to require an explicit --srt flag.
  srt_path: null

templates:
  # Motion-graphics template library location. Both fields are optional; when
  # null, the package's bundled templates/ folder and manifest.json (package
  # data) are used. Point these at a custom folder to add/edit templates with
  # no code change (§3.4).
  templates_dir: null
  manifest: null
